# Combined PostgreSQL image with Apache AGE + pgvector
# Built on top of Apache AGE's official image (PG16 based).
FROM apache/age:PG16

# Install pgvector
RUN apt-get update && apt-get install -y git build-essential postgresql-server-dev-16 && \
    git clone --depth 1 --branch v0.7.0 https://github.com/pgvector/pgvector.git && \
    cd pgvector && make && make install && \
    cd .. && rm -rf pgvector && \
    apt-get remove -y git build-essential postgresql-server-dev-16 && \
    apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
